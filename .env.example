BAOSTOCK_DB_PATH=/data/baostock.sqlite3
BAOSTOCK_LOG_PATH=/data/baostock-audit.jsonl
# Synology example: /volume3/docker/baostock-runner/data
BAOSTOCK_HOST_DATA_DIR=./data
# BaoStock account credentials. Leave both empty to use the package default login.
BAOSTOCK_USER_ID=
BAOSTOCK_PASSWORD=
BAOSTOCK_MCP_TRANSPORT=streamable-http
BAOSTOCK_MCP_HOST=0.0.0.0
BAOSTOCK_MCP_PORT=8000
BAOSTOCK_MCP_PATH=/mcp
# True = stateless Streamable HTTP (no session tracking, fixes 404 Session not found)
BAOSTOCK_MCP_STATELESS=true
BAOSTOCK_MIN_INTERVAL_SECONDS=1.0
BAOSTOCK_DAILY_WARNING_LIMIT=10000
BAOSTOCK_DAILY_HARD_LIMIT=20000
BAOSTOCK_MAX_RETRIES=2
BAOSTOCK_RETRY_DELAYS_SECONDS=5,30,120
# Session keepalive: reconnect when idle longer than this (seconds)
BAOSTOCK_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Reconnect once after retries are exhausted (non-blacklist failures)
BAOSTOCK_RECONNECT_ON_FAILURE=true
# Run a light query after login to verify the channel is truly usable
BAOSTOCK_VERIFY_AFTER_LOGIN=true
BAOSTOCK_OFFLINE=false
# --- background fetcher (P1) ---
BAOSTOCK_FETCH_ENABLED=true
BAOSTOCK_FETCH_UNIVERSE=hs300
# fetcher 占每日总预算比例，默认 2/3，MCP 至少保留 1/3
BAOSTOCK_FETCH_BUDGET_RATIO=0.67
BAOSTOCK_FETCH_BATCH_SIZE=50
BAOSTOCK_FETCH_DAILY_START_DATE=2018-01-01
BAOSTOCK_FETCH_FINANCIAL_START_YEAR=2022
BAOSTOCK_FETCH_FINANCIAL_DATASETS=profit
BAOSTOCK_FETCH_ADJUSTFLAGS=3
BAOSTOCK_FETCH_INCLUDE_DIVIDENDS=false
BAOSTOCK_FETCH_INCLUDE_ADJUST_FACTORS=false
BAOSTOCK_FETCH_IDLE_SLEEP_SECONDS=300
BAOSTOCK_FETCH_PAUSE_SLEEP_SECONDS=600
