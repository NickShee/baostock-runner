BAOSTOCK_DB_PATH=/data/baostock.sqlite3
BAOSTOCK_LOG_PATH=/data/baostock-audit.jsonl
# Synology example: /volume3/docker/baostock-runner/data
BAOSTOCK_HOST_DATA_DIR=./data
# BaoStock account credentials. Leave both empty to use the package default login.
BAOSTOCK_USER_ID=
BAOSTOCK_PASSWORD=
BAOSTOCK_MCP_TRANSPORT=streamable-http
BAOSTOCK_MCP_HOST=0.0.0.0
BAOSTOCK_MCP_PORT=8000
BAOSTOCK_MCP_PATH=/mcp
BAOSTOCK_MIN_INTERVAL_SECONDS=1.0
BAOSTOCK_DAILY_WARNING_LIMIT=10000
BAOSTOCK_DAILY_HARD_LIMIT=20000
BAOSTOCK_MAX_RETRIES=2
BAOSTOCK_RETRY_DELAYS_SECONDS=5,30,120
BAOSTOCK_OFFLINE=false
